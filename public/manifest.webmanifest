{
  "id": "/",
  "name": "Take Me Team Portal",
  "short_name": "Take Me",
  "description": "Take Me people, work and operations portal",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0b1115",
  "theme_color": "#0b1115",
  "categories": ["business", "productivity"],
  "lang": "en-GB",
  "dir": "ltr",
  "icons": [
    { "src": "/take-me-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/take-me-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/take-me-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My tasks", "short_name": "Tasks", "url": "/?page=Tasks&source=shortcut", "icons": [{ "src": "/take-me-icon-192.png", "sizes": "192x192" }] },
    { "name": "Create request", "short_name": "New request", "url": "/?create=request&source=shortcut", "icons": [{ "src": "/take-me-icon-192.png", "sizes": "192x192" }] },
    { "name": "Team calendar", "short_name": "Calendar", "url": "/?page=Calendar&source=shortcut", "icons": [{ "src": "/take-me-icon-192.png", "sizes": "192x192" }] }
  ]
}
