# Portable data layer (PostgreSQL is required on Vercel and Forge)
# Local development uses .portal-data automatically when DATABASE_URL is empty.
DATABASE_URL=
# Set false for a PostgreSQL server on the same private Forge machine without TLS.
DATABASE_SSL=true
# Vercel serverless functions should normally use 1; Forge can use 10.
DATABASE_POOL_SIZE=10

# Private Vercel Blob storage (preferred on Vercel; created automatically when a store is connected)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# S3-compatible private file storage fallback (AWS S3, Cloudflare R2, Backblaze B2, etc.)
# Local development uses .portal-data/files automatically when these are empty.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Google Workspace OAuth (configure through Admin > Integrations, then map to secure runtime values)
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_ADMIN_EMAIL=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:3000/api/auth/google/login/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
PORTAL_SESSION_SECRET=
TEMP_ADMIN_USERNAME=
# Store a scrypt-v1 hash, never the temporary password itself.
TEMP_ADMIN_PASSWORD_HASH=
TEMP_ADMIN_EMAIL=mrizwan@takeme.taxi
# ISO timestamp. Temporary login is disabled automatically after this time.
TEMP_ADMIN_EXPIRES_AT=
PORTAL_FORCE_GOOGLE_LOGIN=false
PORTAL_ALLOWED_DOMAIN=takeme.taxi
PORTAL_ADMIN_EMAILS=mrizwan@takeme.taxi
PORTAL_MANAGER_EMAILS=
# Production callback: https://portal.takeme.taxi/api/auth/google/callback
# Production login callback: https://portal.takeme.taxi/api/auth/google/login/callback
# Testing callbacks use the stable Vercel project address, not a per-commit preview URL.

# Instant collaboration gateway (optional on Vercel, recommended on Forge)
# The Next.js app and realtime daemon must share the same 32+ character secret.
REALTIME_TOKEN_SECRET=
REALTIME_URL=
REALTIME_PORT=3001
# Comma-separated exact browser origins; required by the daemon in production.
REALTIME_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Optional integrations
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SMTP_FROM_EMAIL=
WEBHOOK_SIGNING_SECRET=
